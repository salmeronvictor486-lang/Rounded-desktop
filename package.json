{
  "name": "rounded-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Rounded Desktop — suite ofimática gratuita y de código abierto (documentos, hojas de cálculo, presentaciones y PDF).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
